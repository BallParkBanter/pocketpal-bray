# PocketPal Bray release version, read by build-release.sh and android/app/build.gradle.
# versionName must equal the GitHub release tag without the leading "v", so Obtainium
# sees the installed app as up to date. versionCode = upstream versionCode * 100 + N
# (upstream 152 -> 15201, 15203, ...), so it always rises, also across upstream bumps.
export BRAY_VERSION_NAME=1.20.1-bray.3
export BRAY_VERSION_CODE=15203
